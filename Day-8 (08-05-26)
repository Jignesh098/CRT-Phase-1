//Polymorphism
//It means one name but many forms
//same function behaves differently depending upon the type of the object it called
//two types
// 1) Compile time Polymorphism -- Function Overloading -- static
// resolved at compile time
//Function overloads -- same function name but different parameters
// faster execution
// 2) Run time Polymorphism -- Function overriding -- Dynamic 
// resolvedat run time 
//Function run time-- same function name , same namespace, but different class
// uses a virtual keyword in the base class
// acheiving this through the concept of Inheritance

// Problem-2
// Types of Polymorphism -- 2.1
// Function Overloading

#include <iostream>
using namespace std;

class Math {
public:
    void add(int a,int b,int c){
        cout << a+b+c << "\n";
    }
    
public:
    void add(int a,int b){
        cout << a+b << "\n";
    }
    
public:
    void add(int a,int b,int c,int d){
        cout << a+b+c+d << "\n";
    }
};

int main() {
    Math m;
    m.add(6,9,6);
    m.add(6,9);
    m.add(6,9,6,9);
}


// Types of Polymorphism -- 2.2
// Function Overriding

#include <iostream>
using namespace std;

class Animal {
public:
    virtual void sound(){
        cout << "Janwarr hauuuuuuu" << "\n";
    }
};

class Dog : public Animal {
public:
    void sound(){
        cout << "Dog Bhonkaa" << "\n";
    }
};

class Cat {
public:
    void sound(){
        cout << "Billii meowww" <<"\n";
    }
};

int main() {
    Animal a;
    Dog d;
    Cat c;
    a.sound();
    d.sound();
    c.sound();
}
