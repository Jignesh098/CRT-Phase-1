//Problem-1
//Inheritance
//Single Inheritance
#include <iostream>
using namespace std;

class Vehicle {
public:
    void start() {
        cout << "Vehicle Starts " << "\n";
    }
};

class Car : public Vehicle {
public:
    void drive() {
        cout << "Car is running" << "\n";
    }
};

int main() {
    Car obj1;
    obj1.drive();
    obj1.start();
}


//Problem-1.2
//Multilevel Inheritance
#include <iostream>
using namespace std;

class Vehicle {
public:
    void start() {
        cout << "Vehicle Starts " << "\n";
    }
};

class Car : public Vehicle {
public:
    void drive() {
        cout << "Car is running" << "\n";
    }
};

class speedoMeter : public Car {
public:
    void speed(){
        cout << "Car is running at 90km/h" << "\n";
    }
};

int main() {
    speedoMeter obj1;
    obj1.speed();
    obj1.drive();
    obj1.start();
}
